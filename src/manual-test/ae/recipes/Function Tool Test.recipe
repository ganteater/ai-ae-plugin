<Recipe name="Function Tool Test">
	<!-- Example: OpenAI processor with a Function tool and chat messages --> 
	<Extern class="OpenAI" model="gpt-5-mini" apiKey="$var{OPENAI_API_KEY}">
		<!-- Define a function tool that returns mock weather info --> 
		<Function name="get-weather" description="Get current weather for a city" type="object" return="weatherResult">
			<property name="city" type="string" required="true" /> 
			<Task>
				<!-- Mock implementation: set weatherResult property --> 
				<Var name="weatherResult">{ "city": "$var{city}", "forecast": "sunny" }</Var> 
				<Out name="city" level="info" /> 
				<Out name="weatherResult" level="info" /> 
			</Task> 
		</Function> 
		<Function name="get-traffic" description="Get current auto transport traffic for a city" type="object" return="trafficResult">
			<property name="city" type="string" required="true" /> 
			<Task>
				<!-- Mock implementation: set weatherResult property --> 
				<Var name="trafficResult">{ "city": "$var{city}", "traffic": "hard" }</Var> 
				<Out name="city" level="info" /> 
				<Out name="trafficResult" level="info" /> 
			</Task> 
		</Function> 
		<!-- Send chat messages to the model --> 
		<Prompt name="openaiResponse">
			<message>You are a helpful assistant that can call function get-weather and get-traffic when asked.</message> 
			<message>What is the weather and traffic in Paris?</message> 
		</Prompt> 
		<!-- Output model response --> 
		<Out name="openaiResponse" level="info" /> 
	</Extern> 
</Recipe> 
