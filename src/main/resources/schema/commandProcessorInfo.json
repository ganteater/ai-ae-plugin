{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Command Processor Info Schema",
	"type": "object",
	"properties": {
		"name": {
			"type": "string",
			"description": "The name of the command processor."
		},
		"class": {
			"type": "string",
			"description": "The name of the command processor class."
		},
		"commands": {
			"type": "array",
			"description": "An array of supported commands.",
			"items": {
				"$ref": "#/definitions/CommandInfo"
			}
		}
	},
	"required": [
		"name"
	],
	"additionalProperties": false,
	"definitions": {
		"CommandInfo": {
			"type": "object",
			"properties": {
				"commandName": {
					"type": "string",
					"description": "The name of the command."
				},
				"description": {
					"type": "string",
					"description": "A description of what the command does."
				},
				"usecases": {
					"type": "array",
					"description": "An array of command usecases.",
					"items": {
						"type": "string"
					}
				}
			},
			"required": [
				"commandName"
			]
		}
	}
}